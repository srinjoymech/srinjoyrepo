import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error
from sklearn.ensemble import RandomForestRegressor
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import RBF, ConstantKernel as C
from sklearn.neural_network import MLPRegressor
import warnings
warnings.filterwarnings('ignore')

# 1. LOAD DATA & PREPROCESS
print("Loading data and training models...\n")
df = pd.read_csv(r"E:\Project_Capstone\Project Docs\Discharge_Temp, Discharge_SOC, Char.csv")
df.columns = df.columns.str.strip()

X = df[['PCM', 'NP', 'NP_Percentage', 'EG']].values
y = df[['Discharge_Temp', 'Discharge_SOC', 'Charge_Temp', 'Charge_SOC']].values

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# Function to print error metrics
def print_metrics(model_name, model):
    predictions = model.predict(X_scaled)
    r2 = model.score(X_scaled, y) * 100
    mae = mean_absolute_error(y, predictions)
    rmse = np.sqrt(mean_squared_error(y, predictions))
    
    print(f"--- {model_name} Metrics ---")
    print(f"Accuracy (R^2) : {r2:.2f}%")
    print(f"MAE            : {mae:.4f}")
    print(f"RMSE           : {rmse:.4f}\n")

# 2. TRAIN MODELS & CALCULATE ERRORS
# A. Random Forest
rf = RandomForestRegressor(n_estimators=100, random_state=42)
rf.fit(X_scaled, y)
print_metrics("Random Forest", rf)

# B. Gaussian Process Regressor (GPR)
kernel = C(1.0, (1e-3, 1e3)) * RBF(10, (1e-2, 1e2))
gpr = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=9, alpha=0.1, normalize_y=True)
gpr.fit(X_scaled, y)
print_metrics("Gaussian Process (GPR)", gpr)

# C. Artificial Neural Network (ANN)
ann = MLPRegressor(hidden_layer_sizes=(10, 5), solver='lbfgs', max_iter=2000, random_state=42)
ann.fit(X_scaled, y)
print_metrics("Artificial Neural Network (ANN)", ann)

# 3. DEFINE THE CORRECTED GLOBAL SEARCH SPACE
pcms = [0, 1]          # 0: N-eicosane, 1: R35
nps = [1, 2, 3]        # 1: Al2O3, 2: CuO, 3: TiO2
egs = np.arange(0.0, 5.1, 0.1)          # 0% or 5% Expanded Graphite
test_percentages = np.arange(0.0, 10.1, 0.1)

# 4. GRID SEARCH OPTIMIZERS
def run_grid_search(model):
    best_temp = float('inf')
    best_config = {}
    
    for pcm in pcms:
        for np_type in nps:
            for eg in egs:
                # THE PHYSICAL CONSTRAINT RULE
                if pcm == 0 and eg == 5:
                    continue  # Skip! We didn't use EG with N-eicosane
                    
                for p in test_percentages:
                    test_input = np.array([[pcm, np_type, p, eg]])
                    pred = model.predict(scaler.transform(test_input))[0]
                    if pred[0] < best_temp:
                        best_temp = pred[0]
                        best_config = {'PCM': pcm, 'NP': np_type, 'EG': eg, 'P': p, 'Temp': pred[0], 'SOC': pred[1]}
    return best_config

best_rf = run_grid_search(rf)
best_gpr = run_grid_search(gpr)

# 5. GENETIC ALGORITHM OPTIMIZERS
def run_global_ga(model):
    best_overall_temp = float('inf')
    best_config = {}
    
    for pcm in pcms:
        for np_type in nps:
            for eg in egs:
                # THE PHYSICAL CONSTRAINT RULE
                if pcm == 0 and eg > 0:
                    continue  # Skip! N-eicosane MUST have 0% EG
                    
                population = np.random.uniform(0.0, 10.0, 30) 
                for gen in range(50):
                    fitness_scores = []
                    for p in population:
                        test_input = np.array([[pcm, np_type, p, eg]])
                        pred = model.predict(scaler.transform(test_input))[0]
                        fitness_scores.append(pred[0])
                        
                        if pred[0] < best_overall_temp:
                            best_overall_temp = pred[0]
                            best_config = {'PCM': pcm, 'NP': np_type, 'EG': eg, 'P': p, 'Temp': pred[0], 'SOC': pred[1]}
                            
                    sorted_indices = np.argsort(fitness_scores)
                    population = population[sorted_indices]
                    parents = population[:15]
                    
                    children = []
                    while len(children) < 15:
                        p1, p2 = np.random.choice(parents, 2, replace=False)
                        children.append((p1 + p2) / 2.0)
                        
                    for i in range(len(children)):
                        if np.random.rand() < 0.15:
                            children[i] = np.clip(children[i] + np.random.uniform(-0.5, 0.5), 0.0, 10.0)
                    population = np.concatenate((parents, children))
                    
    return best_config

best_ann_ga = run_global_ga(ann)
best_gpr_ga = run_global_ga(gpr)

# 6. PRINT RESULTS
print("CORRECTED GLOBAL OPTIMIZATION RESULTS")
print("-" * 65)
def print_res(name, res):
    print(f"{name.ljust(12)} | PCM:{res['PCM']} | NP:{res['NP']} | EG:{res['EG']}% | Conc: {res['P']:>5.2f}% | Temp: {res['Temp']:.2f} K")

print_res("1. RF", best_rf)
print_res("2. GPR", best_gpr)
print_res("3. ANN-GA", best_ann_ga)
print_res("4. GPR-GA", best_gpr_ga)
print("-" * 65)