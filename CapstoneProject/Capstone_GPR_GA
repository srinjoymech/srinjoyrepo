import pandas as pd
import numpy as np
from sklearn.gaussian_process import GaussianProcessRegressor
from sklearn.gaussian_process.kernels import RBF, ConstantKernel as C
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import mean_absolute_error, mean_squared_error
import warnings
warnings.filterwarnings('ignore')

# ==============================================================================
# STEP 1: LOAD AND PREPARE THE DATA
# ==============================================================================
df = pd.read_csv(r"E:\Project_Capstone\Project Docs\Discharge_Temp, Discharge_SOC, Char.csv")
df.columns = df.columns.str.strip()

X = df[['PCM', 'NP', 'NP_Percentage', 'EG']].values
y = df[['Discharge_Temp', 'Discharge_SOC', 'Charge_Temp', 'Charge_SOC']].values

scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)

# ==============================================================================
# STEP 2: THE HIGH-ACCURACY SURROGATE (Gaussian Process)
# ==============================================================================
# We replace the 43% ANN with the 99% GPR to feed the Genetic Algorithm
kernel = C(1.0, (1e-3, 1e3)) * RBF(10, (1e-2, 1e2))
model = GaussianProcessRegressor(kernel=kernel, n_restarts_optimizer=9, alpha=0.1, normalize_y=True)
model.fit(X_scaled, y)

predictions = model.predict(X_scaled)
print(f"Surrogate Model Trained! Accuracy (R^2): {model.score(X_scaled, y) * 100:.1f}%")
print(f"Mean Absolute Error (MAE):         {mean_absolute_error(y, predictions):.3f}")
print(f"Root Mean Sq Error (RMSE):         {np.sqrt(mean_squared_error(y, predictions)):.3f}\n")

# ==============================================================================
# STEP 3: THE GENETIC ALGORITHM (GA)
# ==============================================================================
print("--- RUNNING GENETIC ALGORITHM (GA) ---")

# PCM: 0=Neicosane, 1=R35 | NP: 1=Al2O3, 2=CuO, 3=TiO2 | EG: 0=No, 1=Yes
TARGET_PCM = 1
TARGET_NP = 1
TARGET_EG = 1

POPULATION_SIZE = 50
GENERATIONS = 100
MUTATION_RATE = 0.15

# Initialize random population (0% to 10%)
population = np.random.uniform(0.0, 10.0, POPULATION_SIZE)

best_overall_temp = float('inf')
best_overall_p = 0
best_overall_soc = 0

for gen in range(GENERATIONS):
    fitness_scores = []
    
    # FITNESS EVALUATION: The GA asks the GPR for the temperature
    for p in population:
        test_input = np.array([[TARGET_PCM, TARGET_NP, p, TARGET_EG]])
        test_input_scaled = scaler.transform(test_input)
        
        # GPR predicts the physics
        pred = model.predict(test_input_scaled)[0]
        pred_temp = pred[0]  
        pred_soc = pred[1]
        
        fitness_scores.append(pred_temp)
        
        if pred_temp < best_overall_temp:
            best_overall_temp = pred_temp
            best_overall_p = p
            best_overall_soc = pred_soc
            
    # SELECTION
    sorted_indices = np.argsort(fitness_scores)
    population = population[sorted_indices]
    parents = population[:POPULATION_SIZE // 2]
    
    # CROSSOVER
    children = []
    while len(children) < (POPULATION_SIZE // 2):
        p1, p2 = np.random.choice(parents, 2, replace=False)
        children.append((p1 + p2) / 2.0)
        
    # MUTATION
    for i in range(len(children)):
        if np.random.rand() < MUTATION_RATE:
            children[i] = np.clip(children[i] + np.random.uniform(-0.5, 0.5), 0.0, 10.0)
            
    population = np.concatenate((parents, children))

# ==============================================================================
# STEP 4: PRINT FINAL RESULTS
# ==============================================================================
print(f"GA Optimal Nanoparticle Concentration:  {best_overall_p:.2f}%")
print(f"Predicted Lowest Discharge Temp:        {best_overall_temp:.2f} K")
print(f"Predicted State of Charge (SOC):        {best_overall_soc:.3f}")