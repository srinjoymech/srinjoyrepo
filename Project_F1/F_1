import fastf1
from fastf1 import plotting
import matplotlib.pyplot as plt
# import pandas as pd
# import numpy as np
# import openpyxl as pxl
fastf1.plotting.setup_mpl(mpl_timedelta_support=True, color_scheme='fastf1')
# cache=fastf1.Cache.enable_cache('cache')  # Enable caching to speed up data retrieval
session=fastf1.get_session(2026,7,'R')  #Race
session.load()

fig, ax = plt.subplots(figsize=(10, 8))
for driver in ('LEC','HAM'):
    laps= session.laps.pick_drivers(driver)
    style = plotting.get_driver_style(identifier=driver,
                                      style=['color', 'linestyle'],
                                      session=session)
    ax.plot(laps['LapNumber'],laps['LapTime'],**style,label=driver)

ax.set_xlabel("Lap Number")
ax.set_ylabel("Lap Time")
plotting.add_sorted_driver_legend(ax, session)
plt.show()