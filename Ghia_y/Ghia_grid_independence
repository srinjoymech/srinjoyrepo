import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from sklearn.metrics import mean_absolute_error, r2_score, mean_squared_error

# ==================================================
# Load your Excel file
# ==================================================
file_path = "Velocity.xlsx"  # Update path if needed

df_65 = pd.read_excel(r"E:\Ansys\Cavity_flow_files\x_vel_65.txt")
df_129 = pd.read_excel(r"E:\Ansys\Cavity_flow_files\x_vel.txt")
df_257 = pd.read_excel(r"E:\Ansys\Cavity_flow_files\x_vel_257.txt")

# ==================================================
# Ghia Re=10000 data
# ==================================================
ghia_data = {
    'y/L': [1.0000, 0.9766, 0.9688, 0.9609, 0.9531, 0.8516, 0.7344, 0.6172,
            0.5000, 0.2813, 0.1719, 0.1016, 0.0703, 0.0625, 0.0547, 0.0000],
    'u/U0': [1.00000, 0.47221, 0.47783, 0.48070, 0.47804, 0.34635, 0.20673, 0.08344,
             0.03111, -0.23186, -0.32709, -0.29730, -0.41657, -0.42537, -0.42735, 0.00000]
}
df_ghia = pd.DataFrame(ghia_data)

# ==================================================
# Interpolate your data to Ghia's y/L points
# ==================================================
y_ghia = df_ghia['y/L'].values

u65_interp = np.interp(y_ghia, df_65['y/L'], df_65['u/U0'])
u129_interp = np.interp(y_ghia, df_129['y/L'], df_129['u/U0'])
u257_interp = np.interp(y_ghia, df_257['y/L'], df_257['u/U0'])
u_ghia = df_ghia['u/U0'].values

# ==================================================
# Calculate MAE, RMSE, R²
# ==================================================
grids = {
    '65×65': u65_interp,
    '129×129': u129_interp,
    '257×257': u257_interp
}

print("\n📊 Error Metrics Compared to Ghia Re=10000")
print("-" * 50)
rmse_values = []
grid_labels = []

for name, u_interp in grids.items():
    mae = mean_absolute_error(u_ghia, u_interp)
    rmse = np.sqrt(mean_squared_error(u_ghia, u_interp))
    r2 = r2_score(u_ghia, u_interp)
    print(f"{name}: MAE = {mae:.5f}, RMSE = {rmse:.5f}, R² = {r2:.5f}")
    
    rmse_values.append(rmse)
    grid_labels.append(name)

# ==================================================
# Plot 1: u‑velocity profiles
# ==================================================
plt.figure(figsize=(10, 6))

plt.plot(df_65['y/L'], df_65['u/U0'], label='65×65', linewidth=1.5)
plt.plot(df_129['y/L'], df_129['u/U0'], label='129×129', linewidth=1.5)
plt.plot(df_257['y/L'], df_257['u/U0'], label='257×257', linewidth=1.5)
plt.scatter(df_ghia['y/L'], df_ghia['u/U0'], color='black', marker='o',
            label='Ghia 1982 (Re=10000)', zorder=5)

plt.xlabel('y/L', fontsize=12)
plt.ylabel('u/U₀', fontsize=12)
plt.title('Grid Independence Study: u-Velocity Profile (Re ≈ 9600)', fontsize=14)
plt.legend()
plt.grid(True, linestyle='--', alpha=0.6)
plt.xlim(0, 1)
plt.ylim(-0.5, 1.1)

plt.savefig('uU0_grid_independence.png', dpi=300, bbox_inches='tight')
plt.show()

# ==================================================
# Plot 2: RMSE Bar Chart
# ==================================================
plt.figure(figsize=(8, 5))
bars = plt.bar(grid_labels, rmse_values, color=['#1f77b4', '#ff7f0e', '#2ca02c'])

# Add value labels on top of bars
for bar in bars:
    height = bar.get_height()
    plt.text(bar.get_x() + bar.get_width()/2., height + 0.002,
             f'{height:.4f}', ha='center', va='bottom', fontsize=11)

plt.ylabel('RMSE', fontsize=12)
plt.title('RMSE Comparison with Ghia (Re=10000)', fontsize=14)
plt.grid(axis='y', linestyle='--', alpha=0.6)
plt.ylim(0, max(rmse_values) * 1.15)

plt.savefig('rmse_comparison.png', dpi=300, bbox_inches='tight')
plt.show()