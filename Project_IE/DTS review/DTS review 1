# Load the data
X_images, y = load_data()
print(f"Data Loaded: {X_images.shape} images")

# ==========================================
# 2. FEATURE EXTRACTION (The CNN)
# ==========================================
print("Initializing VGG16 Feature Extractor...")

# Load VGG16 without the top layer
base_model = VGG16(weights='imagenet', include_top=False, input_shape=(224, 224, 3), pooling='avg')
base_model.trainable = False # Freeze the model

# Preprocess inputs
print("Preprocessing images...")
X_preprocessed = preprocess_input(X_images * 255) # Scale to 0-255 range if inputs are 0-1

# Extract features
print("Extracting features (this may take a moment)...")
X_features = base_model.predict(X_preprocessed, verbose=1)
print(f"Features extracted. Shape: {X_features.shape}")

# ==========================================
# 3. SVM OPTIMIZATION (The Upgrade)
# ==========================================
print("Preparing for SVM training...")

# Scale the features (Crucial for SVM accuracy)
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X_features)

# Split into train and test sets
X_train, X_test, y_train, y_test = train_test_split(X_scaled, y, test_size=0.2, stratify=y, random_state=42)

# Define the parameter grid to search
param_grid = {
    'C': [0.1, 1, 10, 100],           # Regularization parameter
    'gamma': ['scale', 0.1, 0.01],    # Kernel coefficient
    'kernel': ['rbf']                 # Radial Basis Function is usually best for images
}

print("Starting Grid Search to find best SVM parameters...")
# Grid Search will try every combination above to find the best one
grid = GridSearchCV(SVC(random_state=42), param_grid, refit=True, verbose=2, cv=3)
grid.fit(X_train, y_train)

print(f"\nBest Parameters Found: {grid.best_params_}")

# ==========================================
# 4. EVALUATION & PREDICTION
# ==========================================

# The 'grid' object automatically uses the best model found for predictions
y_pred = grid.predict(X_test)

print("\n--- Final Model Performance ---")
print("Accuracy:", accuracy_score(y_test, y_pred))
print(classification_report(y_test, y_pred, zero_division=0))

# Example Prediction on a single test image
sample_idx = 0
sample_feature = X_test[sample_idx].reshape(1, -1)
prediction = grid.predict(sample_feature)
actual = y_test[sample_idx]

print("\n--- Single Sample Check ---")
print(f"Predicted Class: {prediction[0]} ({'Broken' if prediction[0]==1 else 'Healthy'})")
print(f"Actual Class:    {actual} ({'Broken' if actual==1 else 'Healthy'})")